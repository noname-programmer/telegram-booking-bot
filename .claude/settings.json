{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run smoke:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tgcloud status:*)",
      "Bash(npx tgcloud diff:*)",
      "Bash(npx tgcloud fetch:*)",
      "Bash(npx tgcloud webhook)",
      "Bash(npx tgcloud migrate --dry-run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/install-deps.sh", "timeout": 300 }
        ]
      }
    ]
  }
}
