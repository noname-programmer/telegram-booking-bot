# Скопируйте этот файл в standalone/.env и впишите свои значения.
# Файл .env НЕ попадает на GitHub (он в .gitignore).

# Токен бота от @BotFather (/mybots → бот → API Token). Не путать с CLI-токеном Serverless.
BOT_TOKEN=

# Где хранить базу данных (по умолчанию standalone/data/bot.db)
# DB_PATH=./data/bot.db

# 1 — удалить webhook, если бот раньше работал на Telegram Serverless
# DELETE_WEBHOOK=0
